{
  "name": "cup-of-coins",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --env-file=.env --watch app.js",
    "tunnel": "ngrok http 3000"
  },
  "description": "A minimalist pay-what-you-want 'buy me a coffee' support page built with Express, EJS, and MongoDB, using Polar (sandbox) for hosted checkout and webhook-driven payment confirmation.",
  "keywords": [
    "buy-me-a-coffee",
    "polar",
    "express",
    "mongodb",
    "mongoose",
    "ejs",
    "nodejs",
    "webhook",
    "payments",
    "donation",
    "portfolio-project"
  ],
  "author": "Dhrubajyoti Bhattacharjee",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.32.0",
  "dependencies": {
    "@polar-sh/sdk": "0.49.0",
    "ejs": "6.0.1",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "mongoose": "9.9.4"
  }
}
