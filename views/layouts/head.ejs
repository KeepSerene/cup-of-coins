<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<!-- Primary Meta Tags -->
<meta name="title" content="<%= locals.title %>" />
<meta name="author" content="Dhrubajyoti Bhattacharjee" />
<meta
  name="description"
  content="Support KeepSerene's open-source projects and portfolio builds with a pay-what-you-want contribution. Leave a note or drop your @XHandle and get a shoutout on the public supporters wall."
/>
<meta
  name="keywords"
  content="buy me a coffee, support a developer, sponsor, donate, open source, pay what you want, Polar payments, developer portfolio, KeepSerene"
/>
<meta name="robots" content="index, follow" />
<meta name="theme-color" content="#0F141A" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content="https://cup-of-coins.onrender.com/" />
<meta property="og:title" content="<%= locals.title %>" />
<meta
  property="og:description"
  content="Support KeepSerene's open-source projects and portfolio builds with a pay-what-you-want contribution."
/>
<meta
  property="og:image"
  content="https://cup-of-coins.onrender.com/images/home.png"
/>
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content="CupO'Coins home page — a pay-what-you-want contribution form and public supporters wall"
/>
<meta property="og:site_name" content="CupO'Coins | KeepSerene" />
<meta property="og:locale" content="en_US" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content="https://cup-of-coins.onrender.com/" />
<meta name="twitter:title" content="<%= locals.title %>" />
<meta
  name="twitter:description"
  content="Support KeepSerene's open-source projects and portfolio builds with a pay-what-you-want contribution."
/>
<meta
  name="twitter:image"
  content="https://cup-of-coins.onrender.com/images/home.png"
/>
<meta
  name="twitter:image:alt"
  content="CupO'Coins home page — a pay-what-you-want contribution form and public supporters wall"
/>
<meta name="twitter:site" content="@UsualLearner" />
<meta name="twitter:creator" content="@UsualLearner" />

<!-- Canonical URL -->
<link rel="canonical" href="https://cup-of-coins.onrender.com/" />

<!-- Favicon -->
<link
  rel="shortcut icon"
  href="/images/favicon.svg"
  type="image/svg+xml"
  sizes="any"
/>

<!-- Work Sans google font -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;700&display=swap"
  rel="stylesheet"
/>

<!-- Material symbols rounded (static icon font) -->
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0..1,0..200"
/>

<!-- Custom CSS -->
<link rel="stylesheet" href="/css/styles.css" />

<!-- Custom JS -->
<script src="/js/script.js" defer></script>

<!-- Title -->
<title><%= locals.title %></title>
