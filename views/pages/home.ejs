<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../layouts/head", { title: "CupO'Coins | KeepSerene" }) %>
  </head>

  <body class="background on-surface-text custom-scrollbar"> 
    <!-- Top bar (Header) -->
    <header class="top-bar">
      <div class="wrapper">
          <a href="/" class="logo">
            <img src="/images/logo.svg" width="32" height="32" alt="CupO'Coins logo" class="logo-img">
            <span class="logo-text title-large">CupO'Coins</span>
          </a>
      </div>
    </header>

    <!-- Main -->
    <main class="main">
      <article>
        <!-- Success banner -->
        <% if (showThankYouBanner) { %>
          <div class="wrapper">
            <p class="card success-banner body-medium" data-success-banner>
              🎉 Thank you for your contribution!
            </p>
          </div>
        <% } %>

        <!-- Hero section -->
         <section class="hero">
          <div class="wrapper">
            <figure class="hero-banner">
              <img src="/images/hero-banner.webp" width="2236" height="703" alt="Cover image" fetchpriority="high" class="figure-img">
            </figure>

            <div class="hero-card">
              <figure class="card-img">
                <img src="/images/avatar.png" width="440" height="440" alt="" fetchpriority="high" class="figure-img">
              </figure>

              <div class="card-content">
                <h2 class="title-large">KeepSerene</h2>

                <p class="subtitle body-medium on-surface-variant-text">Full-Stack Engineer</p>

                <p class="card-text body-medium on-surface-variant-text text-italic">Turning caffeine into code. If you like what I build, fuel the next commit.</p>
              </div>
            </div>
          </div>
         </section>

         <div class="wrapper lg-col-2">
            <!-- Contribute section -->
            <section class="card elevated contribute">
              <h2 class="title-medium">Sponsor a project</h2>

              <form class="contribute-form" data-contribute-form>
                <!-- Counter -->
                <div class="counter-wrapper">
                  <div class="body-medium on-surface-variant-text counter-label">
                    <span class="material-symbols-rounded primary-text icon-small">favorite</span>
          
                    $1 each
                  </div>

                  <div class="counter">
                    <button type="button" class="icon-btn filled" data-decrement-btn>
                      <span class="material-symbols-rounded">remove</span>

                      <div class="state-layer"></div>
                    </button>

                    <div class="text-field-wrapper counter-val-field">
                      <input type="text" inputmode="numeric" pattern="\d*" name="amount" value="1" min="1" step="1" max="999" required class="text-field outlined body-large" data-form-field data-counter-val-field>
                    </div>

                    <button type="button" class="icon-btn filled" data-increment-btn>
                      <span class="material-symbols-rounded">add</span>

                      <div class="state-layer"></div>
                    </button>
                  </div>
                </div>

                <!-- Name input -->
                <div class="text-field-wrapper">
                  <label for="name" class="text-field-label body-large">Name</label>

                  <input type="text" name="name" id="name" maxlength="60" placeholder="Name or @XHandle (optional)" class="text-field outlined body-large" data-form-field>
                </div>

                <!-- Email input -->
                <div class="text-field-wrapper">
                  <label for="email" class="text-field-label body-large">Email*</label>

                  <input type="email" name="email" id="email" placeholder="your@email.com" required class="text-field outlined body-large" data-form-field>
                </div>

                <!-- Message textarea -->
                <div class="text-field-wrapper">
                  <label for="message" class="text-field-label body-large">Message</label>

                  <textarea name="message" id="message" maxlength="500" placeholder="Leave a note (optional)" class="text-field outlined body-large" data-form-field data-message-field></textarea>
                </div>

                <!-- Character counter -->
                <div class="char-counter label-small on-surface-variant-text" data-char-counter>0/500</div>

                <!-- Form error -->
                <p class="form-error body-medium" data-form-error hidden></p>

                <!-- Submit button -->
                <button type="submit" class="button filled label-large" data-submit-btn>
                  <span data-btn-label>Contribute $<span data-total-contribution-span>1</span></span>
                  <span class="spinner" data-spinner aria-hidden="true"></span>

                  <div class="state-layer"></div>
                </button>
              </form>
            </section>

            <!-- About + History (Recent supporters) -->
            <div>
              <!-- About -->
              <section class="card outlined about">
                <h2 class="title-medium">About</h2>

                <p class="card-text on-surface-variant-text body-medium">
                  Self-taught engineer with a Mathematics & Computing background. I build full-stack web apps and specialize in AI infra: self-hosting ML models and orchestrating the async pipelines that run them in production.
                </p>

                <p class="on-surface-variant-text body-medium container">
                  <span class="material-symbols-rounded icon-small">alternate_email</span>

                  <a href="mailto:keepserene.dev@gmail.com" class="text-link primary-text">Ping me</a>
                </p>

                <!-- Socials -->
                <ul class="socials-list">
                  <!-- Portfolio -->
                  <li>
                    <a href="https://math-to-dev.vercel.app/" target="_blank" aria-label="Visit my portfolio" title="Portfolio" class="social-link">
                      <img src="/images/globe.svg" width="24" height="24" alt="Portfolio icon">
                    </a>
                  </li>

                  <!-- LinkedIn -->
                  <li>
                    <a href="https://www.linkedin.com/in/dhrubajyoti-bhattacharjee-320822318/" target="_blank" aria-label="Visit my LinkedIn" title="LinkedIn" class="social-link">
                      <img src="/images/linkedin.svg" width="24" height="24" alt="LinkedIn icon">
                    </a>
                  </li>

                  <!-- GitHub -->
                  <li>
                    <a href="https://github.com/KeepSerene" target="_blank" aria-label="Visit my GitHub" title="GitHub" class="social-link">
                      <img src="/images/github.svg" width="24" height="24" alt="GitHub icon">
                    </a>
                  </li>

                  <!-- X (Twitter) -->
                  <li>
                    <a href="https://x.com/UsualLearner" target="_blank" aria-label="Visit my X (Twitter)" title="X (Twitter)" class="social-link">
                      <img src="/images/x.svg" width="24" height="24" alt="X (Twitter) icon">
                    </a>
                  </li>
                </ul>
             </section>

              <!-- History (Recent supporters) -->
              <section class="card outlined history">
                <h2 class="title-medium">Recent supporters</h2>

                <% if (recentSupporters.length) { %>
                  <ul class="history-list">
                    <% recentSupporters.forEach(function (supporter) { %>
                      <li class="history-card">
                        <div class="card-header">
                          <div class="card-avatar label-large avatar-color-<%= supporter.avatarColorIndex %>">
                            <%= supporter.initials %>
                          </div>

                          <h3 class="title-small card-title">
                            <% if (supporter.name.startsWith('@')) { %>
                              <a href="https://x.com/<%= supporter.name.slice(1) %>" target="_blank" rel="noopener noreferrer" class="text-link primary-text">
                                <%= supporter.name %>
                              </a>
                            <% } else { %>
                              <%= supporter.name %>
                            <% } %>
                            contributed <span class="primary-text">$<%= supporter.amount %></span>
                          </h3>
                        </div>

                        <% if (supporter.message) { %>
                          <p class="card-body body-large on-surface-variant-text">
                            <%= supporter.message %>
                          </p>
                        <% } %>
                      </li>
                    <% }); %>
                  </ul>
                <% } else { %>
                  <p class="body-medium on-surface-variant-text">Be the first to leave a note!</p>
                <% } %>
              </section>
            </div>
          </div>
      </article>
    </main>

    <!-- Footer -->
    <footer class="footer">
      <p class="body-medium on-surface-variant-text">
        &copy; <span class="copyright-year" data-copyright-year></span> KeepSerene.
      </p>
    </footer>
  </body>
</html>
